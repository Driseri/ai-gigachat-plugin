{
  "name": "GigaChat Assistant",
  "id": "ai-assistant",
  "manifestVersion": 1,
  "version": "2.0.4",
  "minSupVersion": "18.13.1",
  "description": "GigaChat assistant for managing tasks, projects, and tags in Super Productivity desktop.",
  "author": "Community",
  "hooks": ["taskComplete", "currentTaskChange"],
  "permissions": [
    "nodeExecution",
    "getTasks",
    "getArchivedTasks",
    "getCurrentContextTasks",
    "addTask",
    "updateTask",
    "deleteTask",
    "batchUpdateForProject",
    "getAllProjects",
    "addProject",
    "updateProject",
    "getAllTags",
    "addTag",
    "updateTag",
    "reorderTasks",
    "showSnack",
    "notify",
    "openDialog",
    "persistDataSynced",
    "loadSyncedData",
    "dispatchAction"
  ],
  "iFrame": true,
  "sidePanel": true,
  "isSkipMenuEntry": true,
  "icon": "icon.svg"
}
